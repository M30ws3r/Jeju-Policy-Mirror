# 복사해서 .env 로 쓰되, .env 는 커밋하지 않는다. 값은 `python scripts/gen_keys.py` 로 만든다.

APP_ENV=development            # development | production
# 프런트엔드 출처 1개만. 와일드카드(*) 불가. 운영 예: https://myapp.com
CORS_ORIGIN=https://localhost:5173
TRUSTED_HOSTS=                  # 운영 필수. 예: api.myapp.com
COOKIE_SAMESITE=lax             # 프런트와 API 가 같은 사이트면 lax, 다른 도메인이면 none
COOKIE_SECURE=true

JWT_SECRET=                     # 32자 이상
DATA_KEYS=                      # v1:<base64 32바이트>[,v2:<...>]
ACTIVE_KEY_ID=v1
INDEX_KEY=                      # base64 32바이트

# 비워 두면 로컬 SQLite. Neon 예: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

AUTH_REQUIRED=false             # 센터 키오스크: false (계정·개인정보 저장 없음) / 공개 웹: true
DATA_MODE=sample                # sample | real
DATA_DIR=

# 선택: LLM (없어도 전 기능 동작)
LLM_PROVIDER=none               # none | ollama | openai_compat
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
LLM_API_KEY=
